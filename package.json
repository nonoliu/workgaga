{
  "name": "@workgaga/workspaces",
  "description": "a new markdown editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/workgaga.git"
  },
  "author": "workgaga",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "yarn workspace workgaga run iconfont",
    "prepare": "husky",
    "changeset": "npx @changesets/cli",
    "changeset-version": "npx @changesets/cli version",
    "dev": "yarn workspace workgaga dev",
    "build": "yarn workspace workgaga build",
    "dev:client": "yarn workspace @workgaga/client tauri dev",
    "build:client": "yarn workspace @workgaga/client tauri build",
    "build:vscodePlugin": "yarn workspace workgaga build && yarn workspace workgaga-vscode-plugin build",
    "example:react": "yarn workspace @workgaga/react_demo dev",
    "test": "yarn workspace workgaga test",
    "test:update": "yarn workspace workgaga test:update",
    "lint:all": "yarn workspace workgaga lint && yarn workspace @workgaga/client lint && yarn workspace workgaga-vscode-plugin lint",
    "lint:fix:all": "yarn workspace workgaga lint:fix && yarn workspace @workgaga/client lint:fix && yarn workspace workgaga-vscode-plugin lint:fix"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@changesets/cli": "^2.29.5",
    "@cherry-markdown/changesets-changelog-github": "^0.0.1",
    "@commitlint/config-conventional": "21.0.0",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commitlint": "21.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-tencent": "^1.1.3",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "~9.1.7",
    "lint-staged": "~12.5.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.2",
    "vite": "^6.4.1",
    "vitest": "^3.1.3",
    "vue-eslint-parser": "^10.2.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.ts": "eslint --fix",
    "*.{js,ts,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=24",
    "yarn": ">=1.22.18"
  },
  "resolutions": {
    "glob-parent": "5.1.2",
    "set-value": "4.0.1",
    "lodash.template": "4.5.0",
    "yargs-parser": "20.2.9",
    "xmldom": "0.5.0",
    "ansi-regex": "5.0.1",
    "glob-watcher": "6.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
